# =========================================================================
# whatsthenew — variables de entorno
# Copia este archivo a .env y completa lo que necesites. Nada es obligatorio
# salvo que quieras usar Reddit con token.
# =========================================================================

# --- Reddit (app OAuth gratuita: https://www.reddit.com/prefs/apps) ---
# Sin esto, Reddit se consulta por RSS con pausas largas (menos fiable).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=whatsthenew/0.1 by bulletformyvalentinefan

# --- OpenCode (motor de análisis) ---
OPENCODE_BIN=opencode
OPENCODE_AGENT=plan-updater
OPENCODE_MODEL=

# --- Rutas ---
PLAN_FILE=./GOD_PLAN.md
OUTPUT_FILE=./output/PROPOSED_UPDATES.md
TMP_RAW=/tmp/whatsthenew_raw.json

# --- Ritmo de peticiones (segundos entre requests) ---
HTTP_DELAY_SECONDS=4
REDDIT_DELAY_SECONDS=10

# --- Notificación opcional ---
DISCORD_WEBHOOK=
