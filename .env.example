# =========================================================================
# whatsthenew — variables de entorno
#
# Copia este archivo a `.env` y completa lo que necesites:
#     cp .env.example .env && chmod 600 .env
#
# El repositorio es PÚBLICO: `.env` está ignorado por git y NUNCA debe
# subirse. Aquí va todo lo que necesita credenciales o apunta a algo.
# =========================================================================

# -------------------------------------------------------------------------
# Reddit — DESACTIVADO por defecto (ENABLE_REDDIT=0)
#
# Reddit bloquea por IP con 429/403 incluso desde la red de casa, así que el
# pipeline usa solo fuentes web. Si algún día consigues credenciales OAuth
# (https://www.reddit.com/prefs/apps, tipo "script"), pon ENABLE_REDDIT=1.
# -------------------------------------------------------------------------
ENABLE_REDDIT=0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# -------------------------------------------------------------------------
# User-Agent: obligatorio para Reddit (bloquea user-agents genéricos).
# Sé honesto y pon un contacto.
# -------------------------------------------------------------------------
USER_AGENT=whatsthenew/0.1 (market watcher by TU_USUARIO_REDDIT)

# -------------------------------------------------------------------------
# Reddit — endpoints y ritmo (valores por defecto; cámbialos solo si Reddit
# modifica sus direcciones).
# -------------------------------------------------------------------------
REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token
REDDIT_OAUTH_BASE=https://oauth.reddit.com
REDDIT_WWW_BASE=https://www.reddit.com
REDDIT_DELAY_SECONDS=10
REDDIT_LIMIT=15
REDDIT_TIMEOUT_SECONDS=25
REDDIT_RETRIES=2
# Cuántos hilos (top N por búsqueda) se revisan para contar sus respuestas.
REDDIT_REPLIES_TOP_N=5

# -------------------------------------------------------------------------
# Reddit sin login (espejo público PullPush). Trae tema + fecha + nº de
# respuestas en una sola petición. Déjalo vacío para usar solo el RSS.
# -------------------------------------------------------------------------
PULLPUSH_URL=https://api.pullpush.io/reddit/search/submission/?subreddit={subreddit}&q={query}&size={size}&sort=desc

# -------------------------------------------------------------------------
# HTTP general (pausa anti-bloqueo entre peticiones)
# -------------------------------------------------------------------------
HTTP_DELAY_SECONDS=4
HTTP_TIMEOUT_SECONDS=25

# -------------------------------------------------------------------------
# OpenCode (motor de análisis)
# -------------------------------------------------------------------------
OPENCODE_BIN=opencode
OPENCODE_AGENT=plan-updater
# Modelo a usar (provider/model#variant). Vacío = el modelo por defecto de OpenCode.
# En un contenedor conviene fijarlo, p.ej.: openrouter/deepseek/deepseek-v4.1-flash:decart
OPENCODE_MODEL=

# Clave del proveedor del modelo (OpenRouter en el ejemplo). SOLO en .env.
# La inferencia corre en el proveedor; el servidor solo manda el prompt.
OPENROUTER_API_KEY=

# -------------------------------------------------------------------------
# Repositorio PRIVADO del plan de carrera
#
# El plan NUNCA vive en este repo (es público). Vive en su propio repo privado.
# El pipeline lo clona, le propone cambios y abre un PR que tú revisas.
# -------------------------------------------------------------------------
PLAN_REPO=bulletformyvalentinefan/god-plan
PLAN_REPO_BRANCH=main
# Token con permiso SOLO sobre ese repo privado:
#   contents:write  +  pull_requests:write
PLAN_REPO_TOKEN=
# Abrir el PR automáticamente al terminar (el servidor lo pone en "1").
PUBLISH_PROPOSAL=0
PROPOSAL_BRANCH_PREFIX=proposal

# Identidad de autor de los commits de la propuesta.
GIT_AUTHOR_NAME=whatsthenew bot
GIT_AUTHOR_EMAIL=whatsthenew@users.noreply.github.com

# -------------------------------------------------------------------------
# GitHub API (roadmap.sh y creación del PR)
# -------------------------------------------------------------------------
GITHUB_API_BASE=https://api.github.com
GITHUB_WEB_BASE=https://github.com

# -------------------------------------------------------------------------
# Rutas
#
# PLAN_DIR es el clon EFÍMERO del repo privado (se borra al terminar).
# -------------------------------------------------------------------------
PLAN_DIR=/tmp/whatsthenew-plan
PLAN_FILE=/tmp/whatsthenew-plan/GOD_PLAN.md
OUTPUT_FILE=./output/PROPOSED_UPDATES.md
PROPOSED_PLAN_FILE=./output/GOD_PLAN.proposed.md
TMP_RAW=/tmp/whatsthenew_raw.json

# -------------------------------------------------------------------------
# Notificación opcional (webhook de Discord/Slack)
# -------------------------------------------------------------------------
DISCORD_WEBHOOK=

# -------------------------------------------------------------------------
# Repositorio público (lo usa scripts/protect-branch.sh; si se omite, se deduce
# de `git remote get-url origin`)
# -------------------------------------------------------------------------
GITHUB_REPO=bulletformyvalentinefan/whatsthenew
