[Unit]
Description=whatsthenew — disparo semanal (lunes 04:00)
Documentation=https://github.com/bulletformyvalentinefan/whatsthenew

[Timer]
# Lunes a las 04:00, hora local del servidor.
OnCalendar=Mon 04:00
# Si el servidor estaba apagado a esa hora, se ejecuta al arrancar.
Persistent=true
# Fecha de referencia estable (no depende del arranque).
Unit=whatsthenew.service

[Install]
WantedBy=timers.target
